# Set these in Vercel → Settings → Environment Variables; never in the repo. Redeploy after changing any.
DATABASE_URL=            # injected by Neon when attached from the Storage tab
PASSCODE=                # the one passcode for the welcome gate
CRON_SECRET=             # Vercel sends it as a bearer token to the cron routes
CANVAS_URL=              # e.g. https://school.instructure.com (CANVAS_LINK also accepted)
CANVAS_TOKEN=            # a personal access token from Canvas → Settings
GOOGLE_CLIENT_ID=        # OAuth client for the Calendar read scope
GOOGLE_CLIENT_SECRET=
GARMIN_EMAIL=            # Garmin Connect sign-in (MFA must be off)
GARMIN_PASSWORD=
HQ_TZ=America/Chicago    # optional; the zone used when reading Garmin's timestamps
VAPID_PUBLIC_KEY=        # from: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
